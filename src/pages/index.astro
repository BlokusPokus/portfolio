---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
const repoUrl = 'https://github.com/BlokusPokus/portfolio'
---

<Layout class="max-w-[70.4rem]">
  <PageHead slot="head" title="Home" />
  <section
    class="@container grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 [&>article]:min-h-0 [&>article]:min-w-0"
  >


    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <div
        class="flex min-h-0 min-w-0 flex-1 flex-col gap-3 overflow-y-auto p-6"
      >
        <h2 class="text-lg font-medium leading-snug">Hi, I'm Ian!</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          I build products at the edge of AI, security, and creative tools. This
          site is where I ship in public, write, and share what I learn.
        </p>
      </div>
    </article>
    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <div class="flex min-h-0 min-w-0 flex-1 flex-col p-6">
        <h2 class="mb-4 shrink-0 text-lg font-medium leading-snug">
          Latest blogs
        </h2>
        <ul class="min-h-0 flex-1 space-y-3 overflow-y-auto pr-1">
          {
            blog.map((post) => (
              <li>
                <Link href={`/blog/${post.id}`} class="text-sm hover:underline">
                  {post.data.title}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card/40 aspect-square w-full self-start"
    >
      <div class="h-full min-h-0 min-w-0 flex-1 overflow-hidden rounded-md">
        <img
          src="/static/IMG_4216.JPG"
          alt="Portfolio image placeholder"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <div
        class="flex min-h-0 min-w-0 flex-1 flex-col gap-3 overflow-y-auto p-6"
      >
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-medium leading-snug">Member of</h2>
          <img
            src="/static/image.png"
            alt="Implication logo"
            class="block h-8 w-auto shrink-0 object-contain brightness-0 invert"
          />
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed">
          <Link
            href="https://www.coalitionforsecureai.org"
            class="text-foreground"
            underline
            external>Coalition for Secure AI (CoSAI)</Link
          > an open ecosystem focused on secure-by-design AI through shared standards, research, and guidance.
        </p>
      </div>
    </article>
    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <div class="flex h-full min-h-0 min-w-0 flex-col justify-between p-6">
        <Link
          href={repoUrl}
          class="flex min-w-0 flex-1 items-center justify-center"
          aria-label="Open GitHub repository"
          title="Open GitHub repository"
          external
        >
          <img
            src="/image.png"
            alt="GitHub logo"
            class="h-24 w-24 object-contain brightness-0 dark:invert sm:h-28 sm:w-28"
          />
        </Link>

      </div>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-[2/1] w-full self-start sm:col-span-2 sm:aspect-auto sm:h-[calc((100cqw-1rem)/2)] sm:max-h-[calc((100cqw-1rem)/2)] lg:h-[calc((100cqw-3rem)/4)] lg:max-h-[calc((100cqw-3rem)/4)]"
    >
      <Link
        href="https://github.com/BlokusPokus/SplitSound"
        class="flex min-h-0 min-w-0 flex-1 flex-col gap-2 overflow-hidden p-6 transition-none"
        external
      >
        <h3 class="shrink-0 text-lg font-medium leading-snug">SplitSound</h3>
        <p
          class="text-muted-foreground min-h-0 min-w-0 flex-1 overflow-y-auto text-pretty text-sm"
        >
          SplitSound is a build-in-public audio separation project designed to
          remove hard-to-clean noise from real-world footage and make
          stem-quality cleanup simple for non-technical creators.
        </p>
        <p class="text-muted-foreground/70 shrink-0 text-xs">2026 -> Present</p>
        <div
          class="flex shrink-0 flex-nowrap gap-2 overflow-x-auto pb-0.5 [scrollbar-width:thin]"
        >
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Python
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            SQL
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Docker
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            SAM-audio
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            FastAPI
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Redis
          </span>
        </div>
      </Link>
    </article>
    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card/40 aspect-square w-full self-start"
    >
      <Link
        href="https://www.youtube.com/@DroneTrailTales"
        class="flex min-h-0 min-w-0 flex-1 flex-col items-center justify-center gap-3 p-6"
        aria-label="Visit DroneTrailTales on YouTube"
        title="Visit DroneTrailTales on YouTube"
        external
      >
        <img
          src="/static/youtube.png"
          alt="YouTube logo"
          class="h-20 w-20 object-contain brightness-0 dark:invert"
        />
        <span class="text-sm font-medium">DroneTrailTales</span>
      </Link>
    </article>
    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card/40 aspect-square w-full self-start"
    >
      <div class="h-full min-h-0 min-w-0 flex-1 overflow-hidden rounded-md">
        <img
          src="/static/Mon%20film.jpg"
          alt="Portfolio image placeholder"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-[2/1] w-full self-start sm:col-span-2 sm:aspect-auto sm:h-[calc((100cqw-1rem)/2)] sm:max-h-[calc((100cqw-1rem)/2)] lg:h-[calc((100cqw-3rem)/4)] lg:max-h-[calc((100cqw-3rem)/4)]"
    >
      <Link
        href="https://github.com/BlokusPokus/ai_assistant"
        class="flex min-h-0 min-w-0 flex-1 flex-col gap-2 overflow-hidden p-6 transition-none"
        external
      >
        <h3 class="shrink-0 text-lg font-medium leading-snug">Bloop</h3>
        <p
          class="text-muted-foreground min-h-0 min-w-0 flex-1 overflow-y-auto text-pretty text-sm"
        >
          A production-ready, multi-user AI assistant platform with secure auth
          (JWT, MFA, RBAC), Redis/Postgres infrastructure, and integrations for
          productivity workflows.
        </p>
        <p class="text-muted-foreground/70 shrink-0 text-xs">2025 -> 2026</p>
        <div
          class="flex shrink-0 flex-nowrap gap-2 overflow-x-auto pb-0.5 [scrollbar-width:thin]"
        >
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Python
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            FastAPI
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            PostgreSQL
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Redis
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Docker
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            TypeScript
          </span>
        </div>
      </Link>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <div
        class="flex min-h-0 min-w-0 flex-1 flex-col justify-between overflow-y-auto p-6"
      >
        <h2 class="text-lg font-medium leading-snug">Resume</h2>
        <p class="text-muted-foreground text-sm">
          A concise overview of experience, selected work, and technical skills.
        </p>
        <Link
          href="/static/CV%20-%20Ian%20Le%20Blanc%20.pdf"
          class="text-sm underline underline-offset-4"
          external
        >
          View Resume
        </Link>
      </div>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-[2/1] w-full self-start sm:col-span-2 sm:aspect-auto sm:h-[calc((100cqw-1rem)/2)] sm:max-h-[calc((100cqw-1rem)/2)] lg:h-[calc((100cqw-3rem)/4)] lg:max-h-[calc((100cqw-3rem)/4)]"
    >
      <Link
        href="/agents-and-pipelines"
        class="flex min-h-0 min-w-0 flex-1 flex-col justify-between gap-3 overflow-y-auto p-6 transition-none"
      >
        <div class="flex flex-col gap-3">
          <h2 class="text-lg font-medium leading-snug">Agents and Pipelines</h2>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Notes on AI-assisted coding: how I wire agents, tools, and models
            into pipelines that stay reliable end to end—more detail soon.
          </p>
        </div>
        <span class="text-sm underline underline-offset-4">
          Open agents and pipelines
        </span>
      </Link>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card aspect-square w-full self-start"
    >
      <Link
        href="/graveyard"
        class="flex min-h-0 min-w-0 flex-1 flex-col justify-between gap-3 overflow-y-auto p-6 transition-none"
      >
        <div class="flex flex-col gap-3">
          <h2 class="text-lg font-medium leading-snug">Graveyard</h2>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Dead projects and what I learned—post-mortems and honest notes.
          </p>
        </div>
        <span class="text-sm underline underline-offset-4">Open graveyard</span>
      </Link>
    </article>

    <article
      class="flex min-h-0 flex-col overflow-hidden rounded-lg border bg-card/40 aspect-square w-full self-start"
    >
      <div class="h-full min-h-0 min-w-0 flex-1 overflow-hidden rounded-md">
        <img
          src="/static/IMG_0043%20(1).jpeg"
          alt="Portfolio image placeholder"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>
  </section>
</Layout>
