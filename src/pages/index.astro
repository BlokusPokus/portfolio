---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { Image } from 'astro:assets'

import bentoImg4216 from '../assets/bento/img-4216.jpg'
import bentoImg0043 from '../assets/bento/img-0043.jpeg'
import bentoMonFilm from '../assets/bento/mon-film.jpg'

const blog = await getRecentPosts(SITE.featuredPostCount)
const repoUrl = 'https://github.com/BlokusPokus/portfolio'

/** Matches the bento grid: 1 col mobile, 2 cols sm, 4 cols lg */
const bentoPhotoSizes =
  '(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw'
const bentoPhotoWidths = [480, 720, 960, 1280] as const
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Home" />
  <section
    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:items-stretch"
  >


    <article class="rounded-lg border bg-card p-6 aspect-square">
      <div class="flex h-full flex-col gap-3">
        <h2 class="text-lg font-medium leading-snug">Hi, I'm Ian!</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          I build products at the edge of AI, security, and creative tools. This
          site is where I ship in public, write, and share what I learn.
        </p>
      </div>
    </article>
    <article class="rounded-lg border bg-card p-6 aspect-square">
      <div class="flex h-full flex-col">
        <h2 class="mb-4 text-lg font-medium leading-snug">Latest blogs</h2>
        <ul class="space-y-3 overflow-auto pr-1">
          {
            blog.map((post) => (
              <li>
                <Link href={`/blog/${post.id}`} class="text-sm hover:underline">
                  {post.data.title}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <article
      class="relative isolate overflow-hidden rounded-lg border bg-card/40 aspect-[3/2] sm:aspect-[4/5] lg:aspect-square"
    >
      <!-- Astro Image: picture is inline; prod adds width/height — clip with absolute fill. -->
      <div
        class="absolute inset-0 overflow-hidden [&_picture]:block [&_picture]:size-full [&_img]:size-full [&_img]:object-cover"
      >
        <Image
          src={bentoImg4216}
          alt="Portfolio photo"
          widths={[...bentoPhotoWidths]}
          sizes={bentoPhotoSizes}
          quality={85}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article class="rounded-lg border bg-card p-6 aspect-square">
      <div class="flex h-full flex-col gap-3">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-medium leading-snug">Member of</h2>
          <img
            src="/static/image.png"
            alt="Implication logo"
            class="block h-8 w-auto shrink-0 object-contain brightness-0 invert"
          />
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed">
          <Link
            href="https://www.coalitionforsecureai.org"
            class="text-foreground"
            underline
            external>Coalition for Secure AI (CoSAI)</Link
          > an open ecosystem focused on secure-by-design AI through shared standards, research, and guidance.
        </p>
      </div>
    </article>
    <article class="rounded-lg border bg-card p-6 aspect-square ">
      <div class="flex h-full flex-col justify-between">
        <Link
          href={repoUrl}
          class="flex flex-1 items-center justify-center"
          aria-label="Open GitHub repository"
          title="Open GitHub repository"
          external
        >
          <img
            src="/image.png"
            alt="GitHub logo"
            class="h-24 w-24 object-contain brightness-0 dark:invert sm:h-28 sm:w-28"
          />
        </Link>

      </div>
    </article>

    <article
      class="rounded-lg border bg-card p-6 aspect-[2/1] sm:col-span-2"
    >
      <Link
        href="https://github.com/BlokusPokus/SplitSound"
        class="flex h-full flex-col gap-2 transition-none"
        external
      >
        <h3 class="text-lg font-medium">SplitSound</h3>
        <p class="text-muted-foreground text-sm">
          SplitSound is a build-in-public audio separation project designed to
          remove hard-to-clean noise from real-world footage and make
          stem-quality cleanup simple for non-technical creators.
        </p>
        <p class="text-muted-foreground/70 mt-auto text-xs">2026 -> Present</p>
        <div class="flex flex-wrap gap-2">
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Python
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            SQL
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Docker
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            SAM-audio
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            FastAPI
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Redis
          </span>
        </div>
      </Link>
    </article>
    <article class="rounded-lg border bg-card/40 p-6 aspect-square">
      <Link
        href="https://www.youtube.com/@DroneTrailTales"
        class="flex h-full flex-col items-center justify-center gap-3"
        aria-label="Visit DroneTrailTales on YouTube"
        title="Visit DroneTrailTales on YouTube"
        external
      >
        <img
          src="/static/youtube.png"
          alt="YouTube logo"
          class="h-20 w-20 object-contain brightness-0 dark:invert"
        />
        <span class="text-sm font-medium">DroneTrailTales</span>
      </Link>
    </article>
    <article
      class="relative isolate overflow-hidden rounded-lg border bg-card/40 aspect-[3/2] sm:aspect-[4/5] lg:aspect-square"
    >
      <div
        class="absolute inset-0 overflow-hidden [&_picture]:block [&_picture]:size-full [&_img]:size-full [&_img]:object-cover"
      >
        <Image
          src={bentoMonFilm}
          alt="Portfolio photo"
          widths={[...bentoPhotoWidths]}
          sizes={bentoPhotoSizes}
          quality={85}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <article
      class="rounded-lg border bg-card p-6 aspect-[2/1] sm:col-span-2"
    >
      <Link
        href="https://github.com/BlokusPokus/ai_assistant"
        class="flex h-full flex-col gap-2 transition-none"
        external
      >
        <h3 class="text-lg font-medium">Bloop</h3>
        <p class="text-muted-foreground text-sm">
          A production-ready, multi-user AI assistant platform with secure auth
          (JWT, MFA, RBAC), Redis/Postgres infrastructure, and integrations for
          productivity workflows.
        </p>
        <p class="text-muted-foreground/70 mt-auto text-xs">2025 -> 2026</p>
        <div class="flex flex-wrap gap-2">
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Python
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            FastAPI
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            PostgreSQL
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Redis
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            Docker
          </span>
          <span class="bg-muted text-muted-foreground rounded-md px-2 py-1 text-xs">
            TypeScript
          </span>
        </div>
      </Link>
    </article>

    <article class="rounded-lg border bg-card p-6 aspect-square">
      <div class="flex h-full flex-col justify-between">
        <h2 class="text-lg font-medium leading-snug">Resume</h2>
        <p class="text-muted-foreground text-sm">
          A concise overview of experience, selected work, and technical skills.
        </p>
        <Link
          href="/static/CV%20-%20Ian%20Le%20Blanc%20.pdf"
          class="text-sm underline underline-offset-4"
          external
        >
          View Resume
        </Link>
      </div>
    </article>

    <article
      class="rounded-lg border bg-card p-6 aspect-[2/1] sm:col-span-2"
    >
      <div class="flex h-full flex-col gap-3">
        <h2 class="text-lg font-medium leading-snug">Agents and Pipelines</h2>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Notes on AI-assisted coding: how I wire agents, tools, and models into
          pipelines that stay reliable end to end—more detail soon.
        </p>
      </div>
    </article>

    <article class="rounded-lg border bg-card p-6 aspect-square">
      <Link
        href="/graveyard"
        class="flex h-full flex-col justify-between gap-3 transition-none"
      >
        <div class="flex flex-col gap-3">
          <h2 class="text-lg font-medium leading-snug">Graveyard</h2>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Dead projects and what I learned—post-mortems and honest notes.
          </p>
        </div>
        <span class="text-sm underline underline-offset-4">Open graveyard</span>
      </Link>
    </article>

    <article
      class="relative isolate overflow-hidden rounded-lg border bg-card/40 aspect-[3/2] sm:aspect-[4/5] lg:aspect-square"
    >
      <div
        class="absolute inset-0 overflow-hidden [&_picture]:block [&_picture]:size-full [&_img]:size-full [&_img]:object-cover"
      >
        <Image
          src={bentoImg0043}
          alt="Portfolio photo"
          widths={[...bentoPhotoWidths]}
          sizes={bentoPhotoSizes}
          quality={85}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>
  </section>
</Layout>
