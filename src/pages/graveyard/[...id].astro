---
import '@/styles/global.css'
import '@/styles/typography.css'

import ArticleHead from '@/components/article-head.astro'
import TopicArticlePage from '@/components/topic-article-page.astro'
import TOCHeader from '@/components/toc-header.astro'
import Layout from '@/layouts/layout.astro'
import { getGraveyardEntries } from '@/lib/data-utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const entries = await getGraveyardEntries()
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const basePath = '/graveyard'
---

<Layout>
  <ArticleHead
    slot="head"
    title={entry.data.title}
    description={entry.data.description}
  />
  {
    headings && headings.length > 0 && (
      <TOCHeader slot="table-of-contents" headings={headings} />
    )
  }
  <TopicArticlePage
    entry={entry}
    basePath={basePath}
    breadcrumbs={[
      { href: '/blog', label: 'Blog', icon: 'lucide:library-big' },
      { href: basePath, label: 'Graveyard', icon: 'lucide:archive' },
      {
        href: `${basePath}/${entry.id}`,
        label: entry.data.title,
        icon: 'lucide:book-open-text',
      },
    ]}
    headings={headings}
  >
    <Content slot="content" />
  </TopicArticlePage>
</Layout>
