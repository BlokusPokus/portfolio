---
import '@/styles/global.css'
import '@/styles/typography.css'

import Breadcrumbs from '@/components/breadcrumbs.astro'
import Layout from '@/layouts/layout.astro'
import PageHead from '@/components/page-head.astro'
import TopicEntryCard from '@/components/topic-entry-card.astro'
import { getAgentsEntries } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

const entries = await getAgentsEntries()
const lastUpdated =
  entries[0]?.data.date ?? new Date('2026-04-01')
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Agents and Pipelines" />

  <Breadcrumbs
    items={[
      { href: '/blog', label: 'Blog', icon: 'lucide:library-big' },
      {
        label: 'Agents and Pipelines',
        icon: 'lucide:workflow',
      },
    ]}
  />

  <div class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8">
    <section class="flex flex-col gap-y-4">
      <div class="font-medium lowercase">agents and pipelines</div>
      <p class="text-muted-foreground text-sm">
        Automations, tooling, and how I run agents end to end · Last updated:
        {formatDate(lastUpdated)}
      </p>
    </section>

    <article class="prose max-w-none">
      <p class="mt-0">
        This is where I document how I wire AI agents, scripts, and models
        into pipelines that stay reliable: boundaries between steps, failure
        handling, and what I automate versus what I keep human-in-the-loop.
      </p>
      <p>
        Expect short, practical notes—stack choices, patterns that survived
        production, and things I retired when they stopped earning their
        complexity. More write-ups will land here as I ship them.
      </p>
    </article>

    <section class="flex flex-col gap-y-4">
      <div class="font-medium">Entries</div>
      <ul class="flex flex-col gap-4">
        {
          entries.length === 0 ? (
            <li>
              <div class="rounded-xl border p-4 text-muted-foreground text-sm leading-relaxed">
                No notes yet. Add a markdown file under{' '}
                <code class="text-foreground/80">src/content/agents/</code> with{' '}
                <code class="text-foreground/80">title</code>,{' '}
                <code class="text-foreground/80">description</code>, and{' '}
                <code class="text-foreground/80">date</code> in the frontmatter.
                Copy <code class="text-foreground/80">_example.md</code>, then
                remove <code class="text-foreground/80">draft: true</code> to
                publish.
              </div>
            </li>
          ) : (
            entries.map((entry) => (
              <li>
                <TopicEntryCard entry={entry} />
              </li>
            ))
          )
        }
      </ul>
    </section>
  </div>
</Layout>
